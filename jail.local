[DEFAULT]
banaction = iptables-allports
ignoreip  = 127.0.0.1/8 172.16.0.0/12 10.0.0.0/8 192.168.0.0/16
usedns    = no
backend   = polling

bantime           = 10m
bantime.increment = true
bantime.factor    = 2
bantime.maxtime   = 1d
bantime.rndtime   = 30s

[sshd]
enabled = false

[sshd-ddos]
enabled = false

[http-flood]
enabled  = true
port     = http,https,3000
filter   = http-flood
logpath  = /var/log/app/access.log
maxretry = 60
findtime = 10s
